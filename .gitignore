# ==========================================
# Codemind - Root .gitignore
# Full-stack Next.js (client) + FastAPI (server)
# ==========================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Environment Variables & Secrets
.env
.env.*
!.env.example
!.env*.example
*.pem
*.key
*.cert

# ------------------------------------------
# Frontend / Client (Next.js & Node)
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Next.js build output
.next/
out/
build/
dist/

# TypeScript & tooling cache
*.tsbuildinfo
next-env.d.ts
.vercel/

# Yarn
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------
# Backend / Server (Python & FastAPI)
# ------------------------------------------
# Bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual Environments
.venv/
venv/
ENV/
env/

# Application Data, Uploads & Persistent Storage
# (ChromaDB persistent dir & user uploads)
data/
server/data/
server/data/chroma/
server/data/uploads/
*.sqlite
*.sqlite3
*.db

# ------------------------------------------
# Testing & Logs
# ------------------------------------------
coverage/
*.log
logs/

paper.tex
paper.pdf
.checkpoint_benchmark.json
